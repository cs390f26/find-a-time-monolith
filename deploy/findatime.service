[Unit]
Description=Find-a-Time Monolith Web Service
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/find-a-time-monolith
Environment="PATH=/home/ec2-user/find-a-time-monolith/.venv/bin"
ExecStart=/home/ec2-user/find-a-time-monolith/.venv/bin/gunicorn -w 2 -b 0.0.0.0:8000 "findatime:create_app()"
Restart=always

[Install]
WantedBy=multi-user.target
